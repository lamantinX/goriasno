# Backend (server.js) — required for the /api/leads Telegram relay.
# Create a bot via @BotFather, then create a channel and add the bot as admin.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional — Express listen port for the backend (defaults to 3001).
# In dev, Vite (npm run dev, port 3000) proxies /api to this port via vite.config.ts.
PORT=3001
